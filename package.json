{
  "name": "rskits",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema offline-first para entrega de kits de eventos esportivos",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --prefix backend",
    "db:seed": "npm run prisma:seed --prefix backend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces",
    "test:frontend": "npm run test --workspace frontend",
    "test:coverage": "npm run test:coverage --workspace frontend",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9"
  },
  "workspaces": [
    "backend",
    "frontend"
  ]
}
