{
  "name": "rskits-desktop",
  "version": "0.2.0",
  "description": "RS KITS Desktop — Electron shell (Next.js + FastAPI local)",
  "productName": "RS KITS",
  "main": "src/main.js",
  "private": true,
  "author": "RS KITS <contato@rskits.local>",
  "homepage": "https://rskits.local",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env RSKITS_DEV=1 electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb",
    "gen-icon": "python3 ../scripts/gen-icon.py --out assets",
    "check": "node --check src/main.js && node --check src/preload.js"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "br.com.rskits.app",
    "productName": "RS KITS",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "backend"
      },
      {
        "from": "../../frontend/out",
        "to": "frontend"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RS KITS",
      "artifactName": "RS-KITS-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Office",
      "maintainer": "RS KITS <contato@rskits.local>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg"
      ]
    },
    "publish": {
      "provider": "generic",
      "url": "https://downloads.example.invalid/rskits"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true
  }
}
